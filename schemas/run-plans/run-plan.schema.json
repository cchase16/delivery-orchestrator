{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odoo-development-factory:schema:run-plan:1",
  "title": "Implementation Run Plan Index",
  "description": "The Markdown document is authoritative for human review; this sidecar indexes stable phases and tasks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_plan_id",
    "revision",
    "requirement",
    "document",
    "phases"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_plan_id": {
      "type": "string",
      "pattern": "^RP-[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "revision": { "type": "integer", "minimum": 1 },
    "requirement": { "$ref": "#/$defs/artifactReference" },
    "document": { "$ref": "#/$defs/artifactReference" },
    "status": {
      "enum": ["draft", "awaiting_review", "approved", "rejected", "superseded"]
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/phase" }
    },
    "planning": { "$ref": "#/$defs/planning" },
    "supersedes_revision": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "revision": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_id", "title", "status", "tasks"],
      "properties": {
        "phase_id": {
          "type": "string",
          "pattern": "^PH-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "status": {
          "enum": [
            "not_started",
            "in_progress",
            "blocked",
            "complete",
            "deferred"
          ]
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/task" }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "title", "status"],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "status": {
          "enum": [
            "not_started",
            "in_progress",
            "blocked",
            "complete",
            "deferred"
          ]
        },
        "allowed_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "validation": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "affected_modules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "forbidden_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "database_concerns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "conflicts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "product_baseline": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{7,64}$"
        }
      }
    }
  }
}
