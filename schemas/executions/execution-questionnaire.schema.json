{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odoo-development-factory:schema:execution-questionnaire:1",
  "title": "Run Execution Questionnaire",
  "description": "Durable operator questions raised by an implementation phase before execution pauses.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "questionnaire_id",
    "run_id",
    "work_package_id",
    "run_plan_id",
    "run_plan_revision",
    "phase_id",
    "task_id",
    "status",
    "revision",
    "created_at",
    "updated_at",
    "questions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "questionnaire_id": {
      "type": "string",
      "pattern": "^QNR-[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "work_package_id": {
      "type": "string",
      "pattern": "^WP-[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "run_plan_id": {
      "type": "string",
      "pattern": "^RP-[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "run_plan_revision": { "type": "integer", "minimum": 1 },
    "phase_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "enum": ["awaiting_input", "answered", "resumed"] },
    "revision": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "resumed_at": { "type": "string", "format": "date-time" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "blocking",
        "question",
        "reason",
        "answer_type",
        "answer",
        "answered_by",
        "answered_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q-[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"
        },
        "status": { "enum": ["open", "answered"] },
        "blocking": { "const": true },
        "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "answer_type": { "enum": ["text", "single_choice"] },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "recommended_answer": { "type": "string", "maxLength": 2000 },
        "answer": { "type": ["string", "null"], "maxLength": 4000 },
        "answered_by": { "type": ["string", "null"], "maxLength": 200 },
        "answered_at": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "answer_type": { "const": "single_choice" } }
          },
          "then": { "required": ["options"] }
        }
      ]
    }
  }
}
