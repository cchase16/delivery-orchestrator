{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odoo-development-factory:schema:acceptance-traceability:1",
  "title": "Acceptance Criteria Traceability Record",
  "description": "Binds every requirement acceptance criterion to implementation tasks and passing validation checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "traceability_id",
    "run_id",
    "requirement",
    "run_plan",
    "criteria",
    "evidence_ids"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "traceability_id": {
      "type": "string",
      "pattern": "^TRC-[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "requirement": { "$ref": "#/$defs/artifactReference" },
    "run_plan": { "$ref": "#/$defs/artifactReference" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^EVD-[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
      }
    }
  },
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "revision": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "statement", "task_ids", "check_names", "status"],
      "properties": {
        "criterion_id": {
          "type": "string",
          "pattern": "^AC-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
        },
        "statement": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
          }
        },
        "check_names": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "status": { "enum": ["verified", "unverified", "failed", "waived"] }
      }
    }
  }
}
