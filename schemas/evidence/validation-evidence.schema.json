{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odoo-development-factory:schema:validation-evidence:1",
  "title": "Validation Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "run_id", "outcome", "checks"],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_id": {
      "type": "string",
      "pattern": "^EVD-[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "sequence": { "type": "integer", "minimum": 1 },
    "run_plan_id": {
      "type": "string",
      "pattern": "^RP-[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "run_plan_revision": { "type": "integer", "minimum": 1 },
    "outcome": { "enum": ["passed", "failed", "blocked", "partial"] },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "result_commit": { "type": "string", "pattern": "^[A-Fa-f0-9]{7,64}$" }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "exit_code"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "status": { "enum": ["passed", "failed", "skipped", "timed_out"] },
        "exit_code": { "type": "integer" },
        "log_path": { "type": "string", "maxLength": 1000 },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
