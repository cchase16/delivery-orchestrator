{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odoo-development-factory:schema:work-package:1",
  "title": "Ordered Implementation Work Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_package_id",
    "revision",
    "status",
    "members"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "work_package_id": {
      "type": "string",
      "pattern": "^WP-[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "revision": { "type": "integer", "minimum": 1 },
    "status": {
      "enum": ["draft", "awaiting_review", "approved", "rejected", "superseded"]
    },
    "sequence_rationale": { "type": "string", "maxLength": 12000 },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/member" }
    },
    "supersedes_revision": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_plan_id", "revision", "path", "sha256", "sequence"],
      "properties": {
        "run_plan_id": {
          "type": "string",
          "pattern": "^RP-[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "revision": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "sequence": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
